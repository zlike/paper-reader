{
  "name": "paper-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node src/server.js",
    "test:backend": "node --test test/*.test.js",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test": "npm run test:backend && npm run test:unit",
    "benchmark:highlight": "node scripts/benchmark-highlight.mjs"
  },
  "dependencies": {
    "express": "4.22.3",
    "ipaddr.js": "2.2.0",
    "multer": "2.5.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "jsdom": "^29.1.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
